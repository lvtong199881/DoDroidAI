{
  "requirement": "56kirdkv 欢迎弹窗新增「AI 配置」说明行",
  "designTokens": {
    "fonts": {
      "android": {
        "latin": "Roboto",
        "cjk": "Noto Sans CJK SC（系统回落）",
        "stack": "Roboto, 'Noto Sans SC', 'Noto Sans CJK SC', sans-serif"
      },
      "preview": {
        "stack": "'Segoe UI', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
        "reason": "Windows 出图环境无 Roboto/Noto Sans CJK，使用系统字体近似；Android 真机以系统字体为准"
      },
      "parallel": "PingFang SC（iOS 设计习惯）不适用于本 Android 项目；本项目字体为系统默认，无需降级，仅出图环境字体近似"
    },
    "colors": {
      "light": {
        "surface": "#FFFFFF",
        "onSurface": "#171A1F",
        "onSurfaceVariant": "#5B6270",
        "primary": "#4D6BFE",
        "onPrimary": "#FFFFFF",
        "outline": "#E3E6EC",
        "surfaceVariant": "#F2F4F7",
        "scrim": "rgba(0, 0, 0, 0.54)",
        "shadow": "0 8px 24px rgba(0, 0, 0, 0.18)"
      },
      "dark": {
        "surface": "#161920",
        "onSurface": "#E6E8EC",
        "onSurfaceVariant": "#A6ADBB",
        "primary": "#8FA6FF",
        "onPrimary": "#0A1F5C",
        "outline": "#2A2F3A",
        "surfaceVariant": "#1E222B",
        "scrim": "rgba(0, 0, 0, 0.54)",
        "shadow": "0 8px 24px rgba(0, 0, 0, 0.55)"
      }
    },
    "typography": {
      "title": {
        "fontSize": 20,
        "fontWeight": 600,
        "lineHeight": 1.3,
        "colorToken": "onSurface",
        "androidStyle": "TextStyle(fontSize: 20, fontWeight: w600, height: 1.3)"
      },
      "note": {
        "fontSize": 13,
        "fontWeight": 400,
        "lineHeight": 1.4,
        "colorToken": "onSurfaceVariant",
        "androidStyle": "TextStyle(fontSize: 13, fontWeight: w400, height: 1.4)"
      },
      "subtitle": {
        "fontSize": 15,
        "fontWeight": 400,
        "lineHeight": 1.4,
        "colorToken": "onSurfaceVariant",
        "androidStyle": "TextStyle(fontSize: 15, fontWeight: w400, height: 1.4)"
      },
      "button": {
        "fontSize": 15,
        "fontWeight": 600,
        "lineHeight": 1.2,
        "colorToken": "onPrimary",
        "androidStyle": "TextStyle(fontSize: 15, fontWeight: w600)"
      },
      "secondaryButton": {
        "fontSize": 15,
        "fontWeight": 500,
        "lineHeight": 1.2,
        "colorToken": "primary",
        "androidStyle": "TextStyle(fontSize: 15, fontWeight: w500)"
      }
    },
    "radius": {
      "dialog": 16,
      "pill": 999
    },
    "icons": {
      "size": 22,
      "strokeWidth": 2,
      "viewport": 24,
      "colorToken": "onSurfaceVariant",
      "items": {
        "close": {
          "materialName": "Icons.close",
          "svg": "<path d=\"M6 6l12 12\"/><path d=\"M18 6L6 18\"/>"
        }
      }
    }
  },
  "copy": {
    "zh": {
      "title": "欢迎使用 DoDroidAI",
      "note": "随时可以在设置里改 AI 配置",
      "subtitle": "说一句话，让手机替你做事。",
      "primary": "开始使用",
      "secondary": "去配置AI"
    },
    "en": {
      "title": "Welcome to DoDroidAI",
      "note": "You can change your AI config anytime in Settings.",
      "subtitle": "Say it, and let your phone do it.",
      "primary": "Get started",
      "secondary": "Set up AI"
    }
  },
