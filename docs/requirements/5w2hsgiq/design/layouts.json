      "dark": {
        "pageBg": "#0F1115",
        "surface": "#161920",
        "onSurface": "#E6E8EC",
        "onSurfaceVariant": "#A6ADBB",
        "primary": "#8FA6FF",
        "onPrimary": "#0A1F5C",
        "scrim": "rgba(0, 0, 0, 0.54)",
        "shadow": "0 8px 24px rgba(0, 0, 0, 0.55)",
        "heroBg": "#1C2436"
