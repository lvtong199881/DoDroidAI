{
  "requirement": "8vt9risz 欢迎弹窗新增「去配置AI」按钮（未配置 AI 时显示，次要按钮置于「开始使用」上方）",
  "designTokens": {
    "fonts": {
      "android": {
        "latin": "Roboto（系统默认）",
        "cjk": "Noto Sans CJK SC（系统回落）",
        "stack": "Roboto, 'Noto Sans SC', 'Noto Sans CJK SC', sans-serif"
      },
      "preview": {
        "stack": "'Segoe UI', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
        "reason": "Windows 出图环境无 Roboto / Noto Sans CJK，用系统字体近似；Android 真机以系统字体为准"
      }
    },
    "colors": {
      "light": {
        "pageBg": "#F7F8FA",
        "surface": "#FFFFFF",
        "onSurface": "#171A1F",
        "onSurfaceVariant": "#5B6270",
        "primary": "#4D6BFE",
        "onPrimary": "#FFFFFF",
        "outline": "#C6CBD4",
        "outlineVariant": "#E1E4EA",
        "scrim": "rgba(0, 0, 0, 0.54)",
        "shadow": "0 8px 24px rgba(0, 0, 0, 0.18)",
        "heroBg": "#EEF2FF"
      },
      "dark": {
        "pageBg": "#0F1115",
        "surface": "#161920",
        "onSurface": "#E6E8EC",
        "onSurfaceVariant": "#A6ADBB",
        "primary": "#8FA6FF",
        "onPrimary": "#0A1F5C",
        "outline": "#3A404C",
        "outlineVariant": "#2A2F39",
        "scrim": "rgba(0, 0, 0, 0.54)",
        "shadow": "0 8px 24px rgba(0, 0, 0, 0.55)",
        "heroBg": "#1C2436"
      }
    },
    "assets": {
      "light": {
        "hero": "../assets/welcome_hero_light.png"
      },
      "dark": {
        "hero": "../assets/welcome_hero_dark.png"
      }
    },
    "typography": {
      "title": {
        "fontSize": 20,
        "fontWeight": 600,
        "lineHeight": 1.3,
        "colorToken": "onSurface",
        "androidStyle": "TextStyle(fontSize: 20, fontWeight: w600, height: 1.3)"
      },
      "intro": {
        "fontSize": 15,
        "fontWeight": 400,
        "lineHeight": 1.4,
        "colorToken": "onSurfaceVariant",
        "androidStyle": "TextStyle(fontSize: 15, height: 1.4)"
      },
      "button": {
        "fontSize": 15,
        "fontWeight": 600,
        "lineHeight": 1.2,
        "colorToken": "onPrimary",
        "androidStyle": "TextStyle(fontSize: 15, fontWeight: w600)"
      }
    },
    "buttonStyles": {
      "primary": {
        "fill": "primary",
        "colorToken": "onPrimary",
        "border": null
      },
      "secondary": {
        "fill": "transparent",
        "colorToken": "primary",
        "border": "outline",
        "borderWidth": 1,
        "note": "OutlinedButton 次要样式：透明底 + 1dp outline 描边 + primary 文字；与主按钮（实心 primary、白字）形成明显视觉权重差"
      }
    },
    "radius": {
      "dialog": 16,
      "pill": 999
    },
    "spacing": {
      "dialogInsetX": 20,
      "dialogInsetY": 24,
      "maxHeightRatio": 0.8,
      "bodyPadding": [20, 24, 8, 24],
      "titleToIntro": 8,
      "footerPadding": [12, 20, 20, 20],
      "buttonHeight": 48,
      "buttonGap": 8
    }
  },
  "copy": {
    "zh": {
      "title": "欢迎使用 DoDroidAI",
      "intro": "说一句话，让手机替你做事。",
      "configureAi": "去配置AI",
      "start": "开始使用"
    },
    "en": {
      "title": "Welcome to DoDroidAI",
      "intro": "Say it, and let your phone do it.",
      "configureAi": "Set up AI",
      "start": "Get started"
    }
  },
  "components": {
    "dialog.twoButtons": {
      "type": "frame",
      "name": "dialog",
      "fill": "surface",
      "radius": 16,
      "clip": true,
      "inset": 20,
      "maxHeightRatio": 0.8,
      "center": true,
      "layout": { "mode": "vertical", "padding": 0, "spacing": 0, "align": "stretch" },
      "children": [
        { "type": "image", "name": "hero", "srcRef": "hero", "aspectRatio": 2, "backdrop": "heroBg" },
        {
          "type": "frame",
          "name": "body",
          "layout": { "mode": "vertical", "padding": [20, 24, 8, 24], "spacing": 8, "align": "stretch" },
          "children": [
            { "type": "text", "name": "title", "textRef": "{{LOCALE}}.title", "typography": "title", "align": "center" },
            { "type": "text", "name": "intro", "textRef": "{{LOCALE}}.intro", "typography": "intro", "align": "center" }
          ]
        },
        {
          "type": "frame",
          "name": "footer",
          "layout": { "mode": "vertical", "padding": [12, 20, 20, 20], "spacing": 8, "align": "stretch" },
          "children": [
            {
              "type": "frame",
              "name": "configureButton",
              "height": 48,
              "radius": 999,
              "fill": "transparent",
              "stroke": "outline",
              "strokeWidth": 1,
              "layout": { "mode": "vertical", "padding": 0, "align": "center", "justify": "center" },
              "children": [
                { "type": "text", "name": "configureLabel", "textRef": "{{LOCALE}}.configureAi", "typography": "button", "colorToken": "primary", "align": "center" }
              ]
            },
            {
              "type": "frame",
              "name": "startButton",
              "height": 48,
              "radius": 999,
              "fill": "primary",
              "layout": { "mode": "vertical", "padding": 0, "align": "center", "justify": "center" },
              "children": [
                { "type": "text", "name": "startLabel", "textRef": "{{LOCALE}}.start", "typography": "button", "colorToken": "onPrimary", "align": "center" }
              ]
            }
          ]
        }
      ]
    },
    "dialog.oneButton": {
      "type": "frame",
      "name": "dialog",
      "fill": "surface",
      "radius": 16,
      "clip": true,
      "inset": 20,
      "maxHeightRatio": 0.8,
